# Backend API
ASPNETCORE_ENVIRONMENT=Development
# Connection string for the API (when running outside docker compose)
ConnectionStrings__Default=Host=localhost;Port=5433;Database=stockwise;Username=stockwise;Password=stockwise_dev_pw
# JWT signing key: minimum 32 characters. ALWAYS override in production.
Jwt__Key=dev-only-stockwise-jwt-signing-key-0123456789abcdef-CHANGE-ME
# Apply EF migrations automatically on startup (development convenience only)
Database__ApplyMigrationsOnStartup=true
# CORS: comma-separated origins of the frontend
Cors__AllowedOrigins__0=http://localhost:5173
